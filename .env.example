# Lightning backend: fake (simulated, default) | lnd | lnbits
NEXUS_LN_BACKEND=fake

# LND (REST). Use a macaroon limited to invoices + offchain payments.
LND_REST_URL=https://127.0.0.1:8080
LND_MACAROON_HEX=
LND_TLS_CERT_PATH=/path/to/tls.cert

# LNbits
LNBITS_URL=https://your-lnbits.example
LNBITS_INVOICE_KEY=
LNBITS_ADMIN_KEY=

# Buyer spending policy
NEXUS_MAX_PAYMENT_SATS=10000
NEXUS_DAILY_LIMIT_SATS=100000
NEXUS_PER_PROVIDER_DAILY_SATS=
NEXUS_MAX_ROUTING_FEE_SATS=50
NEXUS_ALLOWED_PROVIDERS=
NEXUS_FROZEN=0

# Provider
NEXUS_L402_SECRET=
NEXUS_ADMIN_TOKEN=
NEXUS_PLATFORM_URL=

# LLM negotiation (aibtc-nexus demo --llm)
ANTHROPIC_API_KEY=
